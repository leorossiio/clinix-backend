# Copie para .env e preencha. O .env nunca deve ser versionado.
# A API não sobe se uma variável obrigatória estiver faltando.

# ── Obrigatórias ───────────────────────────────────────────────────────────────
# Segredo para assinar os tokens (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Banco: supabase | postgres | memoria (padrão: supabase).
# "memoria" sobe com dados de demonstração e dispensa credenciais.
# BANCO=supabase

# Supabase (só com BANCO=supabase). Use a chave service_role:
# ela só existe no servidor e nunca deve ir para o frontend.
SUPABASE_URL=https://nyfgvjbksgggpjdkmhxv.supabase.co
SUPABASE_KEY=

# PostgreSQL (só com BANCO=postgres). As migrations rodam ao iniciar.
# DATABASE_URL=postgres://clinix:clinix@localhost:5432/clinix

# ── Opcionais (valores padrão entre parênteses) ────────────────────────────────
# Cria usuários e horários de exemplo se o banco estiver vazio (false).
# SEMEAR_DEMONSTRACAO=false
# Nível dos logs JSON: trace | debug | info | warn | error | silent (info).
# LOG_LEVEL=info
# PORT=3000
# Validade do token (8h). Formatos: 60, "2h", "7d".
# JWT_EXPIRES_IN=8h
# Custo do bcrypt (10). Cada +1 dobra o tempo de hash.
# BCRYPT_COST=10
# Origens permitidas pelo CORS, separadas por vírgula (* = qualquer uma).
# Em produção, restrinja ao domínio do frontend.
# CORS_ORIGINS=https://clinix.vercel.app
# Proxies reversos na frente da API (1). Afeta o IP usado no limite de login.
# TRUST_PROXY=1
# Tentativas de login por IP a cada 15 minutos (20).
# LOGIN_RATE_LIMIT=20
# Fuso da clínica, usado para ler/gravar a coluna TIMESTAMP (America/Sao_Paulo).
# TZ_CLINICA=America/Sao_Paulo

# ── Telemetria (OpenTelemetry) ─────────────────────────────────────────────────
# Sem esta variável, a telemetria fica desligada. Com ela, traces, métricas e
# logs vão por OTLP/HTTP para o coletor (ver repositório clinix-infra).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=clinix-api
# Métricas HTTP com as convenções semânticas estáveis.
# OTEL_SEMCONV_STABILITY_OPT_IN=http
